# ══════════════════════════════════════════════
#  portal_app.py — Environment Variables
#  Salin file ini ke .env lalu isi nilainya
# ══════════════════════════════════════════════

# [WAJIB] API Key Groq khusus portal
# Daftar gratis di https://console.groq.com
PORTAL_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [OPSIONAL] Flask secret key — auto-generate jika kosong
# PORTAL_SECRET_KEY=ganti-dengan-random-string-panjang

# [OPSIONAL] FAS Key openNDS — harus sama dengan faskey di /etc/opennds/opennds.conf
PORTAL_FAS_KEY=1234567890

# [OPSIONAL] IP Gateway openNDS — IP router yang menjalankan openNDS
PORTAL_GATEWAY_ADDR=192.168.8.1

# [OPSIONAL] Port server portal (default: 5001)
PORTAL_PORT=5001

# [OPSIONAL] Path SQLite database
# PORTAL_DB_PATH=/var/lib/portal/portal_chat.db

# [OPSIONAL] Jumlah jawaban benar yang dibutuhkan untuk auth (default: 1)
PORTAL_REQUIRED_SCORE=1
